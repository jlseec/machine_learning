import requests
from bs4 import BeautifulSoup #For web scraping
import pandas as pd 
import numpy as np #For Dataframe
import matplotlib.pyplot as plt #For histogram

#Web Scraping
keywords = ["bitcoin", "tariff", "warren buffett"]
query = "+".join(['"Warren Buffett"', "Bitcoin", "Tariff"])  
all_titles = []
page = 0

while len(all_titles) < 50 and page < 15:
    offset = page * 10 + 1 #1>11>21>31>41..
    search_url = f"https://www.bing.com/news/search?q={query}&first={offset}"
    response = requests.get(search_url)
    soup = BeautifulSoup(response.text, 'html.parser')
    headline_links = soup.find_all("a", class_="title")

    for t in headline_links:
        title_text = t.get_text(strip=True)
        title_lower = title_text.lower()  

        
        if any(k in title_lower for k in keywords): #Check if keywords exist in the list
            if title_text.lower() not in [t.lower() for t in all_titles]: #Check duplication
                all_titles.append(title_text)

        if len(all_titles) >= 50:
            break  # Stop if hit 50

    page = page + 1


#Put them into csv
df = pd.DataFrame(all_titles, columns=["Article Title"])
df.to_csv("bing_titles.csv", index=False)
print("Saved to 'bing_titles.csv'.")


#Read CSV to calculate frequency
csv = pd.read_csv("bing_titles.csv")
all_titles = df["Article Title"].tolist()

#Calculate Frequency 
bitcoin_count = sum("bitcoin" in count.lower() for count in all_titles)
tariff_count = sum("tariff" in count.lower() for count in all_titles)
WB_count = sum("warren buffett" in count.lower() for count in all_titles)


#Create table with words frequency
data = pd.DataFrame([["Bitcoin",bitcoin_count],
                ["Tariff",tariff_count],
                ["Warren Buffett",WB_count]])

#Change column name
data = data.rename(columns={0:"Keywords",1:"Frequency"})


#Create Barchart
plt.bar(data["Keywords"], data["Frequency"], color = ["royalblue","Pink","turquoise"])
plt.xlabel("Keywords")
plt.ylabel("Frequency")
plt.title("Article Keywords Occurrency")
plt.ylim(0,60)

plt.text(0,  bitcoin_count,str(bitcoin_count), ha='center', fontsize=24)
plt.text(1, tariff_count, str(tariff_count), ha='center',fontsize=24)
plt.text(2,  WB_count, str(WB_count), ha='center',fontsize=24)
plt.show()
